# Example Environment Configuration
# Copy this file to .env.dev, .env.qa, or .env.prod and update values

# Environment
ENV=dev

# Application URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_TYPE=postgresql

# API Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Test Configuration
HEADLESS=false
SLOW_MO=100
BROWSER=chromium
WORKERS=1

# Test Credentials (for authenticated tests)
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Test@1234

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_SCREENSHOTS=true
ENABLE_VIDEO=true
ENABLE_TRACING=true

# CI/CD
CI=false
START_LOCAL_SERVER=false
