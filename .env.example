# Example Environment Configuration
# Copy this file to .env.dev, .env.qa, or .env.prod and update values

# Environment
ENV=dev

# Application URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_TYPE=postgresql

# API Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Test Configuration
HEADLESS=false
SLOW_MO=100
BROWSER=chromium
WORKERS=1

# Test Credentials (for authenticated tests)
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Test@1234

# Role-based credentials (fall back to TEST_USERNAME/TEST_PASSWORD if not set)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=Admin@1234
USER_USERNAME=user@example.com
USER_PASSWORD=User@1234

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_SCREENSHOTS=true
ENABLE_VIDEO=true
ENABLE_TRACING=true

# CI/CD
CI=false
START_LOCAL_SERVER=false

# Flaky test handling — set to true in CI to exclude @flaky tagged tests from pass rate
SKIP_FLAKY=false

# Health check — set to true to skip base URL reachability check in global setup
SKIP_HEALTH_CHECK=false

# Auth validation — set to false to skip TEST_USERNAME/TEST_PASSWORD requirement check
VALIDATE_AUTH=true

# Xray / JIRA Integration
# Set XRAY_ENABLED=true in CI environment variables (not here) to activate upload
XRAY_ENABLED=false
XRAY_CLOUD=true
# XRAY_CLIENT_ID and XRAY_CLIENT_SECRET for Xray Cloud — store in CI secrets only
# XRAY_TOKEN for Xray Server/DC — store in CI secrets only
JIRA_PROJECT_KEY=PROJ
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
